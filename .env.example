# FlexiTaka Environment Configuration Template

# Backend API Configuration (serves https://flexitaka.online)
BACKEND_APP_ENV=development
BACKEND_PUBLIC_API_BASE_URL=https://flexitaka.online/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=flexitaka
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=super-secret-key-change-in-production-environments

# Website Configuration (serves https://flexitaka.com)
NEXT_PUBLIC_API_BASE_URL=https://flexitaka.online/api/v1
CUSTOMER_WEBSITE_URL=https://flexitaka.com
