# Environment mode: development | staging | production
APP_ENV=development
APP_NAME=FlexiTaka Backend API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Domains & Origin Separation
PUBLIC_API_BASE_URL=https://flexitaka.online/api/v1
CUSTOMER_WEBSITE_URL=https://flexitaka.com

# Database (MongoDB 6+)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=flexitaka

# Cache & Idempotency (Redis 7+)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace-with-a-64-character-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
GUEST_SESSION_EXPIRE_DAYS=30

# Private VPS File Storage
STORAGE_ROOT=/data/flexitaka/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS Allowed Origins
ALLOWED_ORIGINS=["https://flexitaka.com","https://app.flexitaka.com","http://localhost:3000"]
